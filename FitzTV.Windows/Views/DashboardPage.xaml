<Page x:Class="FitzTV.Windows.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:v="using:FitzTV.Windows.Views">
  <Grid ColumnDefinitions="*,320" Padding="12" ColumnSpacing="12">
    <v:LibMpvPlayerView x:Name="Player" Grid.Column="0" />
    <StackPanel Grid.Column="1" Spacing="10">
      <TextBlock Text="Channels" Style="{ThemeResource SubtitleTextBlockStyle}" />
      <ListView x:Name="Channels" SelectionChanged="OnChannel" />
      <TextBlock Text="Upscaling" Style="{ThemeResource BodyStrongTextBlockStyle}" />
      <ComboBox x:Name="Preset" SelectedIndex="0" SelectionChanged="OnVideoOptions">
        <ComboBoxItem Content="Quality" />
        <ComboBoxItem Content="Balanced" />
        <ComboBoxItem Content="Performance" />
      </ComboBox>
      <ToggleSwitch x:Name="FrameGen" Header="Frame generation" IsOn="True" Toggled="OnVideoOptions" />
      <TextBlock x:Name="Status" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Page>
