<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Fitz"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AppsActivity" android:exported="false" android:label="Apps &amp; RAM" />
        <activity android:name=".MonitorActivity" android:exported="false" android:label="Monitor" />
        <activity android:name=".LauncherActivity" android:exported="false" android:label="Launcher manager" />
        <activity android:name=".RemoteActivity" android:exported="false" android:label="Remote"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <service android:name=".MaintenanceJob" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Separate home-screen tile: one click = clean caches + RAM, then closes. -->
        <activity
            android:name=".CleanActivity"
            android:exported="true"
            android:label="@string/clean_name"
            android:icon="@mipmap/ic_clean"
            android:banner="@drawable/banner_clean"
            android:theme="@style/Theme.Fitz.Dialog"
            android:excludeFromRecents="true"
            android:taskAffinity="com.fitztv.shield.clean">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
