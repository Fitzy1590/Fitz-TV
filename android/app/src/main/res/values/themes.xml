<resources>
    <color name="bg">#FF101418</color>
    <color name="panel">#FF1B2128</color>
    <color name="accent">#FF76B900</color>
    <color name="text">#FFE8EAED</color>
    <color name="muted">#FF9AA0A6</color>
    <style name="Theme.Fitz" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Theme.Fitz.Dialog" parent="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>
