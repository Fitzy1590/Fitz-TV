# --- Required ---------------------------------------------------------------
# Password for logging in to the hub (this is your "one account").
APP_PASSWORD=change-me
# Long random string. Signs your session cookie and encrypts saved platform
# credentials on disk. Generate one with: openssl rand -hex 32
APP_SECRET=

# Public URL where the hub is hosted (Yahoo OAuth needs an HTTPS redirect URL).
PUBLIC_URL=http://localhost:5173
PORT=8787

# --- Yahoo Fantasy (official API, OAuth 2) -----------------------------------
# Create an app at https://developer.yahoo.com/apps/ with "Fantasy Sports: Read/Write".
# Redirect URI: ${PUBLIC_URL}/api/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# --- FantasyPros (optional) ----------------------------------------------------
# Partner API key. Without it the hub reads the public ECR pages instead.
FANTASYPROS_API_KEY=

# --- Demo mode -------------------------------------------------------------------
# Set to 1 to run with sample leagues (no accounts needed).
DEMO=0
