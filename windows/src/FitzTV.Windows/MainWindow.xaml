<Window x:Class="FitzTV.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:FitzTV.Core"
        xmlns:vm="using:FitzTV.Windows.ViewModels"
        xmlns:conv="using:FitzTV.Windows.Converters"
        Title="Fitz TV">
  <!-- Zero animation: item container transitions are emptied; nothing uses *ThemeTransition. -->
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>

  <Grid x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown" XYFocusKeyboardNavigation="Enabled">
    <Grid.Resources><conv:BoolToVisibilityConverter x:Key="Vis" /></Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Tabs and search (hidden in Theater) -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12,8"
                Visibility="{Binding IsTheater, Converter={StaticResource Vis}, ConverterParameter=invert}">
      <ToggleButton x:Name="TabChannels" Content="Channels" IsChecked="True" Click="TabChannels_Click" UseSystemFocusVisuals="True" />
      <ToggleButton x:Name="TabFixtures" Content="Fixtures" Click="TabFixtures_Click" UseSystemFocusVisuals="True" />
      <TextBox PlaceholderText="Search channels" Width="240" Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <Button Content="Source" Click="Source_Click" UseSystemFocusVisuals="True" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Docked list pane -->
      <Grid Grid.Column="0" Width="340" Padding="8,0,8,8"
            Visibility="{Binding IsTheater, Converter={StaticResource Vis}, ConverterParameter=invert}">
        <ListView x:Name="ChannelList" ItemsSource="{x:Bind ViewModel.Visible}" IsItemClickEnabled="True"
                  SelectionMode="Single" ItemClick="Channel_ItemClick" XYFocusKeyboardNavigation="Enabled"
                  Visibility="{Binding ShowChannelList, Converter={StaticResource Vis}}">
          <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="core:Channel">
              <StackPanel Padding="0,6">
                <TextBlock Text="{x:Bind Name}" />
                <TextBlock Text="{x:Bind Group}" Opacity="0.65" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <ListView x:Name="FixtureList" ItemsSource="{x:Bind ViewModel.Games}" SelectionMode="None"
                  Visibility="{Binding ShowFixtures, Converter={StaticResource Vis}}">
          <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:GameRow">
              <Grid Padding="0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                  <TextBlock Text="{x:Bind League}" Opacity="0.65" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="{x:Bind Score}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  <TextBlock Text="{x:Bind Status}" Opacity="0.65" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <!-- Playlist setup -->
        <ScrollViewer Visibility="{Binding ShowSetup, Converter={StaticResource Vis}}" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <StackPanel Spacing="8" Padding="12">
            <TextBlock Text="Playlist source" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="M3uBox" Header="M3U URL" />
            <TextBlock Text="or Xtream login" Opacity="0.65" />
            <TextBox x:Name="ServerBox" Header="Server (http://host:port)" />
            <TextBox x:Name="UserBox" Header="Username" />
            <PasswordBox x:Name="PassBox" Header="Password" />
            <Button Content="Save and load" Click="SaveSource_Click" Style="{ThemeResource AccentButtonStyle}" UseSystemFocusVisuals="True" />
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Video placeholder: the native mpv window is positioned over this element -->
      <Grid x:Name="VideoHost" Grid.Column="1" Background="Black" MinWidth="320">
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>

      <!-- Stats drawer: takes its own column so the native video window never covers it. Instant show/hide. -->
      <Grid Grid.Column="2" Width="360" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{Binding IsDrawerOpen, Converter={StaticResource Vis}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="Live now" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,0,0,8" />
        <ListView x:Name="DrawerList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.LiveGames}" SelectionMode="None">
          <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:GameRow">
              <StackPanel Padding="0,8" Spacing="2">
                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Score}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Status}" Opacity="0.65" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>

    <!-- Quick overlay (Ctrl+K / G): channel chips plus now/next. Own row, so it sits below the video. -->
    <StackPanel Grid.Row="2" Padding="12,8" Spacing="6" Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="{Binding IsOverlayOpen, Converter={StaticResource Vis}}">
      <ListView x:Name="OverlayList" ItemsSource="{x:Bind ViewModel.Visible}" IsItemClickEnabled="True" SelectionMode="Single"
                ItemClick="Overlay_ItemClick" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Enabled">
        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
        <ListView.ItemsPanel>
          <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ListView.ItemsPanel>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="core:Channel"><TextBlock Text="{x:Bind Name}" Padding="8,4" /></DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock Text="{x:Bind ViewModel.NowNext, Mode=OneWay}" />
    </StackPanel>

    <!-- Key hints -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20" Padding="12,6" Opacity="0.7"
                Visibility="{Binding IsTheater, Converter={StaticResource Vis}, ConverterParameter=invert}">
      <TextBlock Text="Space  Pause" /><TextBlock Text="F  Theater" /><TextBlock Text="M  Mute" />
      <TextBlock Text="→  Live scores" /><TextBlock Text="Ctrl+K  Quick switch" />
    </StackPanel>
  </Grid>
</Window>
