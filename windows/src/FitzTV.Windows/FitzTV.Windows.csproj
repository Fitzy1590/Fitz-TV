<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows only: needs the Windows App SDK and a Windows host to build. libmpv-2.dll is copied next to the exe when present in libs/. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FitzTV.Windows</RootNamespace>
    <AssemblyName>FitzTV.Windows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\FitzTV.Core\FitzTV.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="libs\libmpv-2.dll" Condition="Exists('libs\libmpv-2.dll')" CopyToOutputDirectory="PreserveNewest" Link="libmpv-2.dll" />
  </ItemGroup>
</Project>
